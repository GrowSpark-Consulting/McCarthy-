# Absolute origin of the deployed site. Used for canonical URLs, sitemap,
# robots.txt and Open Graph image resolution. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sanity (News CMS) -------------------------------------------------------
# All three are required: the build fails loudly if any is missing. They are
# public identifiers, not secrets (the dataset is public-read).

# McCarthy Sanity project ID (sanity.io/manage → McCarthy AI).
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Dataset holding News content, e.g. production.
NEXT_PUBLIC_SANITY_DATASET=
# Pinned API version date, YYYY-MM-DD.
NEXT_PUBLIC_SANITY_API_VERSION=

# Server-only secret shared with the Sanity News webhook. Generate with
# `openssl rand -hex 32`. Never commit a real value, never prefix NEXT_PUBLIC_.
SANITY_REVALIDATE_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# AI Audit form (/ai-audit → POST /api/ai-audit)
#
# The site holds no Google credentials. A Google Apps Script web app owns the
# Google side: it writes the row to the sheet and sends the single admin
# notification through Gmail, under the script owner's account.
#
# Deploy google-apps-script/ai-audit.gs, then paste its /exec URL here.
# Server-side only — never exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Leave empty until the script is deployed. A placeholder value here would be
# treated as real and every submission would fail trying to reach it.
# Format: https://script.google.com/macros/s/XXXXXXXXXXXX/exec
GOOGLE_APPS_SCRIPT_URL=

# Rate limiting. Optional: without these an in-process limiter is used, which
# is exact on a single server and best-effort on serverless.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
