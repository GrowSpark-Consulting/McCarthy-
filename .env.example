# Absolute origin of the deployed site. Used for canonical URLs, sitemap,
# robots.txt and Open Graph image resolution. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sanity (News CMS) -------------------------------------------------------
# All three are required: the build fails loudly if any is missing. They are
# public identifiers, not secrets (the dataset is public-read).

# McCarthy Sanity project ID (sanity.io/manage → McCarthy AI).
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Dataset holding News content, e.g. production.
NEXT_PUBLIC_SANITY_DATASET=
# Pinned API version date, YYYY-MM-DD.
NEXT_PUBLIC_SANITY_API_VERSION=

# Server-only secret shared with the Sanity News webhook. Generate with
# `openssl rand -hex 32`. Never commit a real value, never prefix NEXT_PUBLIC_.
SANITY_REVALIDATE_SECRET=
