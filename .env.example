# Absolute origin of the deployed site. Used for canonical URLs, sitemap,
# robots.txt and Open Graph image resolution. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# AI Audit form (/ai-audit → POST /api/ai-audit)
# All of these are server-side only. None is exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Google Sheets — service account with Editor access to the target spreadsheet.
# Share the sheet with the service account's email address.
GOOGLE_SHEETS_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
# Paste the PEM with literal 
 escapes, wrapped in quotes.
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
MII...
-----END PRIVATE KEY-----
"
# The long id from the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
# Tab name. Defaults to "AI Audit" when unset.
GOOGLE_SHEETS_TAB_NAME=AI Audit

# Email (Resend). EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=McCarthy <hello@yourdomain.com>
AI_AUDIT_NOTIFICATION_EMAIL=team@yourdomain.com

# Rate limiting. Optional: without these an in-process limiter is used, which
# is exact on a single server and best-effort on serverless.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
